# Core
APP_VERSION=0.1.0
# Local Docker defaults. For a VPS use .env.production.example instead.
DEBUG=true
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SECURE_SSL_REDIRECT=false

# PostgreSQL
POSTGRES_DB=global_billing
POSTGRES_USER=global_billing
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Frontend
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_ADVANCED_GLASS=false

# Initial admin (used once by bootstrap_admin)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# Optional compatible remote backup storage
BACKUP_S3_URI=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
